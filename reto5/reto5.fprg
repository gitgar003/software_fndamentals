<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="reto5"/>
        <attribute name="authors" value="Jeferson Garcia"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-11-24 07:11:20 p.&#8239;m."/>
        <attribute name="created" value="SmVmZXJzb24gR2FyY2lhO0xBUFRPUC1WQ1NGNlNQNjsyMDI1LTExLTI0OzA2OjQzOjQwIHAu4oCvbS47MTIyMDI="/>
        <attribute name="edited" value="SmVmZXJzb24gR2FyY2lhO0xBUFRPUC1WQ1NGNlNQNjsyMDI1LTExLTI0OzA3OjExOjIwIHAu4oCvbS47MTsxMjMwNA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valor" type="Integer" array="False" size=""/>
            <declare name="dice1" type="Integer" array="False" size=""/>
            <declare name="dado" type="Integer" array="False" size=""/>
            <declare name="contador1" type="Integer" array="False" size=""/>
            <declare name="contador2" type="Integer" array="False" size=""/>
            <assign variable="valor" expression="0"/>
            <assign variable="contador1" expression="0"/>
            <assign variable="contador2" expression="0"/>
            <output expression="&quot;cant. de veces que desea lanzar el dado&quot;" newline="True"/>
            <input variable="dado"/>
            <for variable="valor" start="1" end="dado" direction="inc" step="1">
                <assign variable="dice1" expression="cont()"/>
                <output expression="&quot;valor: &quot; &amp; dice1" newline="True"/>
                <if expression="dice1%2=0">
                    <then>
                        <assign variable="contador1" expression="contador1+1"/>
                    </then>
                    <else>
                        <assign variable="contador2" expression="contador2+1"/>
                    </else>
                </if>
            </for>
            <output expression="&quot;el total de pares es: &quot; &amp; contador1" newline="True"/>
            <output expression="&quot;el total de impares es: &quot; &amp; contador2" newline="True"/>
        </body>
    </function>
    <function name="cont" type="Integer" variable="dice1">
        <parameters/>
        <body>
            <declare name="dice1" type="Integer" array="False" size=""/>
            <assign variable="dice1" expression="0"/>
            <assign variable="dice1" expression="Random(6)+1"/>
        </body>
    </function>
</flowgorithm>
