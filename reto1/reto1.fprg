    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nnn" type="Integer" array="False" size=""/>
            <declare name="definir" type="Integer" array="False" size=""/>
            <declare name="ENTER" type="String" array="False" size=""/>
            <declare name="num" type="Integer" array="False" size=""/>
            <output expression="&quot;Precione ENTER para lanzar el dado&quot;" newline="True"/>
            <input variable="ENTER"/>
            <assign variable="num" expression="Random(6)+1"/>
            <output expression="num" newline="True"/>
            <assign variable="definir" expression="define(num)"/>
        </body>
    </function>
    <function name="define" type="Integer" variable="nnn">
        <parameters>
            <parameter name="parOimpar" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="nnn" type="Integer" array="False" size=""/>
            <assign variable="nnn" expression="parOimpar%2"/>
            <if expression="nnn=0">
                <then>
                    <output expression="&quot;el numero es par&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;el numero es impar&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
