<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="reto4"/>
        <attribute name="authors" value="Jeferson Garcia"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-11-22 10:49:09 p.&#8239;m."/>
        <attribute name="created" value="SmVmZXJzb24gR2FyY2lhO0xBUFRPUC1WQ1NGNlNQNjsyMDI1LTExLTIyOzEwOjIxOjMxIHAu4oCvbS47MTIxOTE="/>
        <attribute name="edited" value="SmVmZXJzb24gR2FyY2lhO0xBUFRPUC1WQ1NGNlNQNjsyMDI1LTExLTIyOzEwOjQ5OjA5IHAu4oCvbS47MTsxMjMxNA=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="contador" type="Integer" array="False" size=""/>
            <declare name="h" type="Integer" array="False" size=""/>
            <declare name="enter" type="String" array="False" size=""/>
            <assign variable="contador" expression="0"/>
            <output expression="&quot;precione ENTER para sacar un par de 6&quot;" newline="True"/>
            <input variable="enter"/>
            <assign variable="h" expression="rpe()"/>
        </body>
    </function>
    <function name="rpe" type="Integer" variable="j">
        <parameters/>
        <body>
            <declare name="j" type="Integer" array="False" size=""/>
            <declare name="contador" type="Integer" array="False" size=""/>
            <declare name="d1" type="Integer" array="False" size=""/>
            <declare name="d2" type="Integer" array="False" size=""/>
            <assign variable="contador" expression="0"/>
            <assign variable="j" expression="0"/>
            <assign variable="d1" expression="0"/>
            <assign variable="d2" expression="0"/>
            <while expression="d1+d2!=12">
                <assign variable="d1" expression="Random(6)+1"/>
                <assign variable="d2" expression="Random(6)+1"/>
                <assign variable="contador" expression="contador+1"/>
                <output expression="&quot;Tiro &quot; &amp; contador &amp; &quot;:  &quot; &amp; d1 &amp; &quot;,&quot; &amp; d2" newline="True"/>
            </while>
            <output expression="contador" newline="True"/>
        </body>
    </function>
</flowgorithm>
